# .env.example 을 .env 로 복사한 뒤 값을 채운다. (.env 는 커밋하지 않는다)

# 카카오 개발자 콘솔 > 봇 > 인증 토큰
BOT_TOKEN=

# 카카오 개발자 콘솔 > 앱 > 앱 키 > REST API 키 (카카오맵·카카오모빌리티 REST API용)
KAKAO_REST_API_KEY=

# 외부에서 접속 가능한 이 서버의 HTTPS 주소 (위치 전송 페이지 링크에 사용, 예: 터널 주소)
PUBLIC_BASE_URL=https://example.trycloudflare.com

# 웹훅 등록 시 넣은 커스텀 헤더 (비워두면 검증하지 않음)
WEBHOOK_HEADER_NAME=X-Eodiro-Secret
WEBHOOK_HEADER_VALUE=

# Claude API 키 (에이전트용). 없으면 에이전트 호출이 실패하고 기존 명령어 파서로 처리된다.
ANTHROPIC_API_KEY=

# 에이전트 설정 (생략하면 기본값)
# AGENT_ENABLED=1
# AGENT_MODEL=claude-sonnet-5-5
# AGENT_FAST_MODEL=claude-haiku-5-5
# AGENT_EFFORT=low

# 로컬 서버 포트
WEBHOOK_PORT=8000
